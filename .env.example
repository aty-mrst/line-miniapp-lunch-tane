# --- LINE ---
NEXT_PUBLIC_LIFF_ID=
LINE_CHANNEL_ID=

# --- Supabase（Connect → Direct → Transaction pooler / Session pooler） ---
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL_MIGRATE=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# --- 動作モード ---
# true: DBもLIFFも使わずメモリ上のモックで動かす
NEXT_PUBLIC_USE_MOCK=false
# 開発のみ：LIFFなしで x-dev-user ヘッダーで名乗る（?as=U_dev_sato で切替）。本番ビルドでは無効
NEXT_PUBLIC_DEV_AUTH=true
# 開発のみ：「現在時刻」を固定時刻から始める（seed の募集時刻に合わせる）。空なら実時刻
NEXT_PUBLIC_DEV_NOW=2026-09-28T12:05:00+09:00
